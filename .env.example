# ============================================================
#  JARVIS AI — Environment Configuration Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# ── AI Provider (choose one primary, others are fallbacks) ──
AI_PROVIDER=openai               # Options: openai | gemini | ollama | anthropic

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini         # gpt-4o | gpt-4o-mini | gpt-3.5-turbo

# Google Gemini (free alternative)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-flash    # gemini-1.5-flash | gemini-1.5-pro

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Ollama (100% local, no cost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2            # Any model you have pulled

# ── Application Settings ──
JARVIS_NAME=JARVIS
JARVIS_VERSION=1.0.0
ENVIRONMENT=development          # development | production
DEBUG=true

# ── API Server ──
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# ── Autonomy Level (1-5) ──
DEFAULT_AUTONOMY_LEVEL=2

# ── Database ──
DATABASE_URL=sqlite+aiosqlite:///./jarvis.db    # Phase 1: SQLite
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/jarvis  # Phase 3+

# ── Redis (Phase 3+) ──
REDIS_URL=redis://localhost:6379/0

# ── Logging ──
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log

# ── JARVIS Personality ──
JARVIS_PERSONA="You are JARVIS, an advanced artificial intelligence assistant. You are professional, intelligent, calm, and helpful. You address the user respectfully. You think through problems carefully before responding. You are honest about your limitations."
